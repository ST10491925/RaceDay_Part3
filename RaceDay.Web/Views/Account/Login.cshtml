@model LoginForm
@{
    ViewData["Title"] = "Sign in";
}
<div class="auth-wrap">
    <div class="auth-card">
        <h1 class="h2">Sign in</h1>
        <p class="text-muted">Use the account you registered with RaceDay.</p>

        @if (ViewBag.Notice is string notice)
        {
            <div class="alert alert-warning" role="status">@notice</div>
        }

        <form asp-action="Login" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email address</label>
                <input asp-for="Email" class="form-control" autocomplete="email" inputmode="email" required />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" required />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <button type="submit" class="btn btn-signal w-100 btn-lg">Sign in</button>
        </form>

        <p class="mt-4 mb-0 text-center">New to RaceDay? <a asp-action="Register">Create an account</a></p>
    </div>
</div>
