@model ResultManagementViewModel
@{
    ViewData["Title"] = "Results";
    var selected = Model.SelectedEvent;
}
<h1 class="h2 mb-1">Results</h1>
<p class="text-muted mb-4">After an event concludes, record each finisher's time and position. Saved results are published to participants straight away.</p>

<section class="panel mb-4">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-8">
            <label class="form-label" for="eventId">Event</label>
            <select class="form-select" id="eventId" name="eventId" data-autosubmit>
                <option value="">Select an event</option>
                @foreach (var e in Model.Events)
                {
                    <option value="@e.Id" selected="@(selected?.Id == e.Id)">@e.Name (@Format.Date(e.Date))</option>
                }
            </select>
        </div>
        <div class="col-md-4"><button class="btn btn-primary w-100" type="submit">Show entrants</button></div>
    </form>
</section>

@if (selected is null)
{
    <div class="empty-state">
        @Icons.Get("trophy", 32)
        <h2 class="h5">Select an event</h2>
        <p>Choose an event that has finished to enter its results.</p>
    </div>
}
else
{
    if (!Model.Concluded)
    {
        <div class="alert alert-warning d-flex gap-2" role="status">
            @Icons.Get("clock", 20, "mt-1 flex-shrink-0")
            <div>This event starts on @Format.DateTimeFull(selected.Date). Results can be recorded once it has concluded.</div>
        </div>
    }

    if (Model.Rows.Count == 0)
    {
        <div class="empty-state">
            @Icons.Get("users", 32)
            <h2 class="h5">No participants to record</h2>
            <p>There are no active enrolments for this event.</p>
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="table-card-head">
                <h2 class="h5 m-0">@selected.Name</h2>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0 results-table">
                    <thead>
                        <tr>
                            <th scope="col">Participant</th>
                            <th scope="col">Category</th>
                            <th scope="col">Finish time (hh:mm:ss)</th>
                            <th scope="col">Position</th>
                            <th scope="col" class="text-end">Save</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var formId = $"result-{row.Enrolment.Id}";
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(row.Enrolment.ParticipantName) ? "Participant" : row.Enrolment.ParticipantName)</td>
                            <td>@row.Enrolment.CategoryName</td>
                            <td>
                                <input class="form-control form-control-sm time-input" form="@formId" name="FinishTime"
                                       value="@row.Result?.FinishTime" placeholder="01:42:09"
                                       pattern="\d{1,2}:[0-5]\d:[0-5]\d" inputmode="numeric" required
                                       aria-label="Finish time for @row.Enrolment.ParticipantName" disabled="@(!Model.Concluded)" />
                            </td>
                            <td>
                                <input class="form-control form-control-sm pos-input" form="@formId" name="Position" type="number"
                                       min="1" value="@(row.Result is { Position: > 0 } ? row.Result.Position.ToString() : "")" required
                                       aria-label="Position for @row.Enrolment.ParticipantName" disabled="@(!Model.Concluded)" />
                            </td>
                            <td class="text-end text-nowrap">
                                <form id="@formId" asp-action="Save" method="post" class="d-inline">
                                    <input type="hidden" name="EventId" value="@selected.Id" />
                                    <input type="hidden" name="EnrolmentId" value="@row.Enrolment.Id" />
                                    <input type="hidden" name="ResultId" value="@(row.Result?.Id)" />
                                    <button type="submit" class="btn btn-primary btn-sm" disabled="@(!Model.Concluded)">
                                        @Icons.Get("check", 14) @(row.Result is null ? "Publish" : "Update")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
