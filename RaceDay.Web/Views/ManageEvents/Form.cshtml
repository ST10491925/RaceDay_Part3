@model EventForm
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Create event" : "Edit event";
    var dateValue = Model.Date?.ToString("yyyy-MM-dd'T'HH:mm");
    var minDate = isNew ? DateTime.Now.ToString("yyyy-MM-dd'T'HH:mm") : null;
}
<a asp-action="Index" class="back-link">Back to events</a>
<h1 class="h2 mb-4">@ViewData["Title"]</h1>

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? (int?)null : Model.Id)"
      method="post" enctype="multipart/form-data" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-4">
        <div class="col-lg-8">
            <section class="panel">
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label">Event name</label>
                        <input asp-for="Name" class="form-control" maxlength="120" required />
                        <span asp-validation-for="Name" class="field-error"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="5" maxlength="2000" required></textarea>
                        <span asp-validation-for="Description" class="field-error"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Location" class="form-label">Location</label>
                        <input asp-for="Location" class="form-control" maxlength="200" required />
                        <span asp-validation-for="Location" class="field-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Date" class="form-label">Date and start time</label>
                        <input asp-for="Date" type="datetime-local" class="form-control" value="@dateValue" min="@minDate" required />
                        <span asp-validation-for="Date" class="field-error"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="DistanceKm" class="form-label">Distance (km)</label>
                        <input asp-for="DistanceKm" type="number" step="0.1" min="0.1" max="500" class="form-control" required />
                        <span asp-validation-for="DistanceKm" class="field-error"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="EventType" class="form-label">Event type</label>
                        <select asp-for="EventType" class="form-select" asp-items="@(new SelectList(Format.EventTypes))"></select>
                        <span asp-validation-for="EventType" class="field-error"></span>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-lg-4">
            <section class="panel">
                <h2 class="h5">Banner image</h2>
                @if (!string.IsNullOrWhiteSpace(Model.CurrentBannerUrl))
                {
                    <img class="banner-preview" src="@Model.CurrentBannerUrl" alt="Current banner" />
                }
                else
                {
                    <div class="banner-preview lane-art" aria-hidden="true"></div>
                }
                <label class="form-label mt-3" for="banner">@(string.IsNullOrWhiteSpace(Model.CurrentBannerUrl) ? "Upload a banner" : "Replace the banner")</label>
                <input class="form-control" type="file" id="banner" name="banner"
                       accept="image/jpeg,image/png,image/webp" data-max-bytes="5242880" />
                <div class="form-text">JPG, PNG or WebP, up to 5 MB. The image is stored in Azure Blob Storage by the RaceDay API.</div>
                <span class="field-error">@Html.ValidationMessage("banner")</span>
            </section>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-signal btn-lg">@(isNew ? "Create event" : "Save changes")</button>
        <a class="btn btn-outline-secondary btn-lg" asp-action="Index">Cancel</a>
    </div>
</form>
