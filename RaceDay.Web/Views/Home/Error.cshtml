@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="empty-state mx-auto" style="max-width: 560px">
    @Icons.Get("alert", 32)
    @if (Model.Code.HasValue)
    {
        <p class="error-code">@Model.Code</p>
    }
    <h1 class="h3">@Model.Title</h1>
    <p>@Model.Message</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to events</a>
</div>
