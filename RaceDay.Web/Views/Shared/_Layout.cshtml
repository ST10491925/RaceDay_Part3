@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Active(string c, string? a = null) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) &&
        (a is null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#10212F" />
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? t + " | RaceDay" : "RaceDay")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="rd-header">
        <nav class="navbar navbar-expand-lg navbar-dark" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">
                    @Icons.Get("flag", 22)<span>RaceDay</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (Auth.IsOrganiser)
                        {
                            <li class="nav-item"><a class="nav-link @Active("Organiser")" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @Active("ManageEvents")" asp-controller="ManageEvents" asp-action="Index">Events</a></li>
                            <li class="nav-item"><a class="nav-link @Active("ManageCategories")" asp-controller="ManageCategories" asp-action="Index">Categories</a></li>
                            <li class="nav-item"><a class="nav-link @Active("ManageEnrolments")" asp-controller="ManageEnrolments" asp-action="Index">Enrolments</a></li>
                            <li class="nav-item"><a class="nav-link @Active("ManageResults")" asp-controller="ManageResults" asp-action="Index">Results</a></li>
                        }
                        else if (Auth.IsParticipant)
                        {
                            <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Events</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Participant", "MyEvents")" asp-controller="Participant" asp-action="MyEvents">My Events</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Participant", "MyResults")" asp-controller="Participant" asp-action="MyResults">My Results</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Events</a></li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        @if (Auth.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Profile")" asp-controller="Profile" asp-action="Index">
                                    @Icons.Get("user", 16) @Auth.DisplayName
                                    <span class="role-tag">@(Auth.IsOrganiser ? "Organiser" : "Participant")</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm">
                                        @Icons.Get("log-out", 16) Sign out
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link @Active("Account", "Login")" asp-controller="Account" asp-action="Login">Sign in</a></li>
                            <li class="nav-item"><a class="btn btn-signal btn-sm" asp-controller="Account" asp-action="Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="main" class="container py-4 py-lg-5">
        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success d-flex gap-2 align-items-start" role="status">
                @Icons.Get("check", 20, "mt-1 flex-shrink-0")<div>@ok</div>
            </div>
        }
        @if (TempData["Error"] is string bad)
        {
            <div class="alert alert-danger d-flex gap-2 align-items-start" role="alert">
                @Icons.Get("alert", 20, "mt-1 flex-shrink-0")<div>@bad</div>
            </div>
        }
        @if (ViewBag.LoadError is string loadError)
        {
            <div class="alert alert-danger d-flex gap-2 align-items-start" role="alert">
                @Icons.Get("alert", 20, "mt-1 flex-shrink-0")<div>@loadError</div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="rd-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>RaceDay. Run it, walk it, finish it.</span>
            <span>Built on the RaceDay REST API</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
