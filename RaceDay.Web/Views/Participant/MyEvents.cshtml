@model List<EnrolmentItem>
@{
    ViewData["Title"] = "My Events";
    var now = DateTime.Now;
}
<h1 class="h2 mb-1">My Events</h1>
<p class="text-muted mb-4">Every event you have entered, with its current enrolment status.</p>

@if (Model.Count == 0)
{
    <div class="empty-state">
        @Icons.Get("calendar", 32)
        <h2 class="h5">You have not entered any events yet</h2>
        <p>Pick a run or walk and your enrolment will show up here straight away.</p>
        <a class="btn btn-signal" asp-controller="Home" asp-action="Index">Browse events</a>
    </div>
}
else
{
    <div class="table-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Event</th>
                        <th scope="col">Date</th>
                        <th scope="col">Category</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var e in Model)
                {
                    var cancelled = string.Equals(e.Status, "Cancelled", StringComparison.OrdinalIgnoreCase);
                    var upcoming = e.EventDate.HasValue && e.EventDate.Value > now;
                    <tr>
                        <td>
                            @if (e.EventId > 0)
                            {
                                <a asp-controller="Events" asp-action="Detail" asp-route-id="@e.EventId">@e.EventName</a>
                            }
                            else
                            {
                                @e.EventName
                            }
                        </td>
                        <td>@Format.Date(e.EventDate)</td>
                        <td>@e.CategoryName</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td class="text-end">
                            @if (!cancelled && upcoming)
                            {
                                <form asp-action="Cancel" method="post" class="d-inline"
                                      data-confirm="Cancel your entry to @(e.EventName)?">
                                    <input type="hidden" name="enrolmentId" value="@e.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">@Icons.Get("x", 14) Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
